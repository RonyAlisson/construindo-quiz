# Copie para .env.local. No desenvolvimento, os valores vêm de: npx supabase status -o env
# (API_URL → SUPABASE_URL, SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY, ANON_KEY → SUPABASE_ANON_KEY)

# URL da API do Supabase
SUPABASE_URL=http://127.0.0.1:54321

# Chave service_role: só servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Só usada pelos testes de API (confere que a chave pública não acessa os dados)
SUPABASE_ANON_KEY=

# Opcional: desliga o rate limit (usado pelos testes de API e E2E)
# RATE_LIMIT_DISABLED=1
